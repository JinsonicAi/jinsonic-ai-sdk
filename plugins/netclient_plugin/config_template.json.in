{
	"name": "@PLUGIN_NAME@",
	"version": "@PLUGIN_VERSION@",
	"platform": {
		"arch": "@PLUGIN_ARCH@",
		"os": "@PLUGIN_OS@",
		"chip": "@PLUGIN_CHIP@"
	},
	"entry": "lib@PLUGIN_NAME@.so",
	"build_time": "@PLUGIN_BUILD_TIME@",
	"md5": "@PLUGIN_MD5@",
	"type": "@PLUGIN_NAME@",
	"description": "@PLUGIN_NAME@ plugin auto-generated",
	"component": {
		"parentType": "input-component",
		"label": {
			"zh": "网络拉流",
			"en": "Network Pull Stream",
			"vi": "Luồng mạng đầu vào",
			"km": "ទាញស្ទ្រីមតាមបណ្តាញ",
			"lo": "ດຶງສະຕຣີມຜ່ານເຄືອຂ່າຍ"
		},
		"type": "@PLUGIN_NAME@",
		"component": {
			"formList": [
				{
					"type": "input",
					"name": {
						"zh": "RTSP地址",
						"en": "RTSP Address",
						"vi": "Địa chỉ RTSP",
						"km": "RTSP អាសយដ្ឋាន",
						"lo": "RTSP ທີ່ຢູ່"
					},
					"key": "rtsp_url",
					"default": "",
					"placeholder": "rtsp://...",
					"buttons": [
						{
							"type": "onvifSearch",
							"fillKey": "rtsp_url"
						},
						{
							"type": "rtspTest",
							"urlKey": "rtsp_url"
						}
					]
				},
				{
					"type": "input",
					"key": "runtime_location",
					"visible": false,
					"default": "",
					"name": {
						"zh": "运行位置",
						"en": "Runtime Location",
						"vi": "Vị trí chạy",
						"km": "ទីតាំងដំណើរការ",
						"lo": "ຕຳແໜ່ງການເຮັດວຽກ"
					}
				},
				{
					"type": "divider",
					"name": {
						"zh": "按时布控",
						"en": "Scheduled Deployment",
						"vi": "Lịch triển khai",
						"km": "ការដាក់ឱ្យប្រើតាមកាលវិភាគ",
						"lo": "ການນຳໃຊ້ຕາມຕາຕະລາງ"
					}
				},
				{
					"type": "schedule",
					"key": "schedule_config",
					"name": {
						"zh": "布控时段",
						"en": "Schedule",
						"vi": "Lịch trình",
						"km": "កាលវិភាគ",
						"lo": "ຕາຕະລາງ"
					},
					"enabled": true,
					"default": {
						"timezone": "+08:00",
						"schedule": []
					}
				}
			]
		}
	}
}
